NODE_ENV=development
PORT=5000

# MongoDB connection string. Use MongoDB Atlas or a local mongod instance.
MONGODB_URI=mongodb://127.0.0.1:27017/bizpilot

# Frontend origin allowed to call this API (CORS)
CLIENT_URL=http://localhost:5173

# JWT secrets — use long, random, different values in production.
# Business and admin tokens are signed with different secrets so a leaked
# business token can never be used to access the Super Admin console.
JWT_BUSINESS_SECRET=change_me_business_secret
JWT_ADMIN_SECRET=change_me_admin_secret
JWT_EXPIRES_IN=7d

# Brevo (transactional email) — used to send real signup verification codes.
# Get a key at https://app.brevo.com/settings/keys/api
# If left blank, verification codes are logged to the server console instead
# of emailed, so local development still works without a Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@bizpilot.ng
BREVO_SENDER_NAME=BizPilot
